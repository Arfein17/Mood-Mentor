# ─────────────────────────────────────────────────────────
# Mode Mentor Server — Environment Configuration
# Copy this file to .env and fill in values before running.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────

# Server port (Express listens here; Vite proxies /api → this port)
PORT=3001

# Vite dev server origin (for CORS allowlist)
VITE_ORIGIN=http://localhost:5173

# ── AI Model Configuration ────────────────────────────────

# Hugging Face model ID for text emotion classification
# Must be a Xenova-compatible ONNX model hosted on HF Hub
TEXT_MODEL_ID=SamLowe/roberta-base-go_emotions

# Confidence threshold — below this the top emotion is reported as "uncertain"
# Range: 0.0 – 1.0  (default: 0.35)
CONFIDENCE_THRESHOLD=0.35

# Fusion weights (must sum to 1.0 when both signals present)
TEXT_WEIGHT=0.60
FACE_WEIGHT=0.40

# Path to face-api model weights (relative to /server)
FACE_MODELS_PATH=./models/face-api-weights

# ── Runtime ───────────────────────────────────────────────

# "development" | "production"
# In production: employeeId is redacted from logs as well
NODE_ENV=development

# Max upload size in megabytes for selfie images
MAX_UPLOAD_MB=5
